# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/

# MongoDB database name (defaults to "marriage" if not set)
MONGODB_DB=marriage

# Admin dashboard access
VITE_ADMIN_PATH=/owner-rsvp-mr-2026
OWNER_ACCESS_CODE=replace-with-a-private-owner-code
SITE_ACCESS_SECRET=replace-with-a-long-random-cookie-secret

# Optional RSVP email fallback, used only when MongoDB save fails.
# Backup recipients are hardcoded in api/_emailFallback.js.
RESEND_API_KEY=re_...
