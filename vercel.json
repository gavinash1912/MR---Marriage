{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/wedding", "destination": "/index.html" },
    { "source": "/wedding/rsvp", "destination": "/index.html" },
    { "source": "/marriage/celebrations", "destination": "/index.html" },
    { "source": "/marriage/celebrations/rsvp", "destination": "/index.html" },
    { "source": "/admin-mr-2026", "destination": "/index.html" },
    { "source": "/admin-mr-2026/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
